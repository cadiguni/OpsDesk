# Configuração de produção do OpsDesk.
#
# Gere o deploy/.env com segredos aleatórios em vez de copiar este arquivo à mão:
#
#   ./deploy/new-env.sh          (Linux, macOS, Git Bash)
#   .\deploy\new-env.ps1         (Windows PowerShell)
#
# O deploy/.env nunca vai para o repositório. Guarde uma cópia junto do backup: sem o
# JWT_SIGNING_KEY as sessões abertas caem, e sem o POSTGRES_PASSWORD o banco não abre.

# ----- Endereço -----

# Nome pelo qual as pessoas acessam o sistema, sem https://. Para testar na própria
# máquina, use localhost.
OPSDESK_SITE_ADDRESS=opsdesk.empresa.com

# Certificado: "internal" (CA própria do Caddy, para rede interna sem DNS público) ou um
# e-mail (Let's Encrypt, que exige DNS público e portas 80/443 abertas).
OPSDESK_TLS=internal

# Portas publicadas no servidor.
OPSDESK_HTTP_PORT=80
OPSDESK_HTTPS_PORT=443

# ----- Segredos -----

# Senha do banco. Só a API e o próprio banco a usam; o banco não publica porta.
POSTGRES_PASSWORD=

# Chave que assina os tokens de sessão. No mínimo 32 caracteres. Trocá-la derruba todas
# as sessões abertas, o que é exatamente o que fazer se ela vazar.
JWT_SIGNING_KEY=

# ----- Primeiro gestor -----

# Usados só pelo serviço `setup`, e só quando ainda não existe nenhum gestor. A senha é
# provisória: o primeiro login obriga a trocá-la. Depois da instalação, apague a linha.
OPSDESK_ADMIN_EMAIL=
OPSDESK_ADMIN_PASSWORD=

# ----- Avançado -----

# Rede interna do compose. É nela que a API confia para ler o IP do cliente; troque se
# colidir com uma rede da empresa.
OPSDESK_SUBNET=172.28.0.0/16

# Versão das imagens. "local" quando construídas nesta máquina.
OPSDESK_VERSION=local
OPSDESK_IMAGE_PREFIX=opsdesk

# Information, Warning ou Error.
OPSDESK_LOG_LEVEL=Information

# Onde os scripts de backup gravam e de onde a restauração lê.
OPSDESK_BACKUP_DIR=./backups

# ----- Anexos no Azure Blob (opcional) -----

# FileSystem guarda os anexos no volume do compose, e é o certo para um servidor só.
# AzureBlob é para quando a API roda em mais de uma réplica. A autenticação é por
# identidade, nunca por chave da conta: Managed Identity quando a API roda no Azure,
# ou um service principal (as três variáveis AZURE_*) fora dele. A identidade precisa
# do papel "Storage Blob Data Contributor" na conta. Com AzureBlob, o backup.sh não
# copia os anexos: use soft delete e versionamento da própria conta.
OPSDESK_ATTACHMENT_STORAGE=FileSystem
OPSDESK_BLOB_SERVICE_URI=
OPSDESK_BLOB_CONTAINER=attachments
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
