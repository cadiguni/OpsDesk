# Falha a instalação quando a versão do Node não atende ao campo engines.
#
# Sem isto o npm apenas avisa e, pior, omite em silêncio os binários nativos do Vite
# e do oxlint — que declaram engines ^20.19 || >=22.12. O resultado é um `npm install`
# que termina com sucesso e um `npm run build` que estoura por binding ausente.
engine-strict=true
