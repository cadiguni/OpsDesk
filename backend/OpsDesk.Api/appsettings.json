{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "OpsDesk": ""
  },
  "Jwt": {
    "Issuer": "opsdesk",
    "Audience": "opsdesk",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "BusinessHours": {
    "TimeZone": "America/Sao_Paulo",
    "Start": "08:00",
    "End": "18:00"
  },
  "SlaAlerts": {
    "IntervalMinutes": 5,
    "WarningPercent": 25
  },
  "EmailDispatch": {
    "DispatchIntervalSeconds": 30,
    "BatchSize": 20
  },
  "Tickets": {
    "ReopenWindowDays": 7
  },
  "AttachmentStorage": {
    "RootPath": "attachments",
    "PendingRetentionHours": 24,
    "CleanUpIntervalHours": 6
  },
  "RateLimiting": {
    "CredentialAttemptsPerMinute": 20,
    "RefreshAttemptsPerMinute": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
